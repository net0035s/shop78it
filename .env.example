# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/db?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/db

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Admin Authorization (Comma separated emails)
ADMIN_EMAILS=admin@example.com

# Cron Jobs (Vercel Cron Authorization)
CRON_SECRET=your_random_cron_secret

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Security
# ENCRYPTION_KEY must be a secure 32-byte / 64-character hex string.
# Generate locally only when ready: npx tsx scripts/generate-encryption-key.ts --show
# Never commit real keys. Rotate encrypted data before replacing an active key.
ENCRYPTION_KEY=
# Temporary rotation only: set this locally to the previous key when running dry-run/apply rotation.
# Remove it after the rotation is verified. Do not set it for normal runtime unless needed by a one-off job.
OLD_ENCRYPTION_KEY=

# Public canonical URL (also used for private order access emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments remain disabled until migrations, backup, key readiness and provider checks pass.
PAYMENTS_ENABLED=false
# Stripe is a separate channel. Sandbox accepts test server keys only; never paste keys into chat.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Payments (TrueMoney, Stripe, and retained legacy PromptPay/SlipOK routes)
TMN_RECEIVE_PHONE=your_phone
PROMPTPAY_NUMBER=your_promptpay_phone_or_tax_id
SLIPOK_BRANCH_ID=your_slipok_branch_id
SLIPOK_API_KEY=your_slipok_api_key
SLIP_VERIFY_API_KEY=your_slipok_key
SLIP_VERIFY_API_URL=https://api.slipok.com/api/line/apikey

# Launch controls: leave closed until the documented rehearsal and owner approval.
APP_MODE=live
ORDERS_ENABLED=false
LAUNCH_APPROVED=false
# Preview writes require a genuinely separate sandbox database. Fingerprints contain no passwords.
SANDBOX_DATABASE_FINGERPRINT=
PRODUCTION_DATABASE_FINGERPRINT=
# Optional public support email; existing LINE can also be used.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional SMTP server; when empty, existing Gmail configuration is used.
SMTP_HOST=
SMTP_PORT=587
# Record these only after completing and retaining the actual evidence.
BACKUP_RESTORE_VERIFIED=false
MIGRATION_REHEARSAL_VERIFIED=false
PROVIDER_SANDBOX_VERIFIED=false
CLERK_ADMIN_VERIFIED=false
MAINTENANCE_VERIFIED=false
HOSTING_COMMERCIAL_CONFIRMED=false
# One-off backup/rehearsal only. Never set these on the web runtime.
BACKUP_ENCRYPTION_KEY=
PG_DUMP_PATH=
PG_RESTORE_PATH=
SANDBOX_RESTORE_URL=
