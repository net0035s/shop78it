# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:6543/db?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/db

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Admin Authorization (Comma separated emails)
ADMIN_EMAILS=admin@example.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Security (Must be 32-byte / 64-char hex string)
# Generate using: npx tsx scripts/generate-encryption-key.ts
ENCRYPTION_KEY=

# Payments (TrueMoney & Slip)
TMN_RECEIVE_PHONE=your_phone
SLIP_VERIFY_API_KEY=your_slipok_key
SLIP_VERIFY_API_URL=https://api.slipok.com/api/line/apikey
